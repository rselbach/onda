--swift-version 6.2
--exclude shell/macos/.build,shell/macos/Generated,shell/macos/Sources/OndaCore/Generated,target

--disable sortImports
--disable trailingCommas
--disable wrapMultilineStatementBraces
--disable hoistPatternLet
--disable unusedArguments
--disable redundantSendable
--disable redundantMemberwiseInit
--disable elseOnSameLine
--disable modifierOrder
--disable numberFormatting
